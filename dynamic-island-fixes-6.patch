+/**
+ * Tracks where this node's top edge sits on the physical screen, in dp. Cards use it to keep their content
+ * inside the screen and below the camera hole, wherever the island window was calibrated to sit.
+ */
+@Composable
+internal fun Modifier.screenTopTracker(out: androidx.compose.runtime.MutableState<Dp>): Modifier {
+    val view = androidx.compose.ui.platform.LocalView.current
+    val density = LocalDensity.current
+    return this.onGloballyPositioned { c ->
+        val loc = IntArray(2)
+        view.getLocationOnScreen(loc)
+        val y = with(density) { (loc[1] + c.positionInRoot().y).toDp() }
+        if (kotlin.math.abs(y.value - out.value.value) > 1f) out.value = y
+    }
+}
