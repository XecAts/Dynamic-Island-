+@Composable
+private fun InboxCard(item: InboxItem, s: IslandSettings, locked: Boolean, now: Long) {
+    val context = LocalContext.current
+    val tilt = IslandBus.glassTilt.collectAsState()
+    val hidden = locked && item.sensitive
+    val face = if (hidden) item.appIcon else item.avatar ?: item.appIcon
+    val tap = remember { androidx.compose.foundation.interaction.MutableInteractionSource() }
+    // Swipe the card to the left to remove it (there is no X button)
+    val scope = rememberCoroutineScope()
+    val offset = remember { Animatable(0f) }
+    val threshold = with(androidx.compose.ui.platform.LocalDensity.current) { 96.dp.toPx() }
+    fun remove() {
+        if (!locked && NotifListener.canDismiss(item.key)) NotifListener.dismiss(item.key)
+        Inbox.remove(item.key)
+    }
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .graphicsLayer {
+                translationX = offset.value
+                alpha = (1f - abs(offset.value) / (threshold * 4f)).coerceIn(0f, 1f)
+            }
+            .islandSurface(s, true, RoundedCornerShape(30.dp), null, tilt = { tilt.value })
+            .pointerInput(item.key) {
+                detectHorizontalDragGestures(
+                    onDragEnd = {
+                        scope.launch {
+                            if (offset.value < -threshold) {
+                                offset.animateTo(-threshold * 8f, tween(160))
+                                remove()
+                            } else {
+                                offset.animateTo(0f, spring(dampingRatio = 0.7f, stiffness = 500f))
+                            }
+                        }
+                    },
+                    onDragCancel = { scope.launch { offset.animateTo(0f, spring(dampingRatio = 0.7f, stiffness = 500f)) } },
+                ) { change, dragAmount ->
+                    change.consume()
+                    scope.launch { offset.snapTo((offset.value + dragAmount).coerceAtMost(0f)) }
+                }
+            }
+            .clickable(tap, indication = null) {
+                if (!Controls.send(context, item.intent)) Controls.openApp(context, item.pkg)
+                Inbox.remove(item.key)
+                Controls.collapse()
+            }
+            .padding(start = 14.dp, end = 10.dp, top = 12.dp, bottom = 12.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Box(Modifier.size(48.dp)) {
+            if (face != null) {
+                Image(face, null, Modifier.size(48.dp).clip(CircleShape), contentScale = ContentScale.Crop)
+            } else {
+                Box(Modifier.size(48.dp).clip(CircleShape).background(Color(0xFF2C2C2E)), contentAlignment = Alignment.Center) {
+                    Icon(Ios.chatbubble, null, tint = Color.White, modifier = Modifier.size(24.dp))
+                }
+            }
+            // The app the message came from, as on iOS: small icon on the corner of the avatar
+            if (!hidden && item.avatar != null && item.appIcon != null) {
+                Image(item.appIcon, null,
+                    Modifier.size(20.dp).align(Alignment.BottomEnd).border(1.5.dp, Color.Black.copy(alpha = 0.5f), CircleShape).clip(CircleShape),
+                    contentScale = ContentScale.Crop)
+            }
+        }
+        Spacer(Modifier.width(12.dp))
+        Column(Modifier.weight(1f)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(if (hidden) item.appName else item.title, color = Color.White, fontSize = 16.sp,
+                    fontWeight = FontWeight.SemiBold.island, maxLines = 1, overflow = TextOverflow.Ellipsis, modifier = Modifier.weight(1f))
+                Spacer(Modifier.width(6.dp))
+                Text(ago(now - item.time), color = Dim, fontSize = 12.sp, maxLines = 1)
+            }
+            val text = if (hidden) tr("Содержимое скрыто", "Content hidden") else item.text
+            if (text.isNotEmpty()) {
+                Text(text, color = Color.White.copy(alpha = 0.8f), fontSize = 14.sp, maxLines = 2, overflow = TextOverflow.Ellipsis)
+            }
+            if (!hidden) {
+                Text(item.appName, color = Dim, fontSize = 12.sp, maxLines = 1, overflow = TextOverflow.Ellipsis,
+                    modifier = Modifier.padding(top = 2.dp))
+            }
+        }
+    }
+}
 
