+/**
+ * The opened messages bubble: every notification is a card of its own, one under the other like the stopwatch
+ * and live cards. Three people on Instagram are three cards. Newest on top; tapping a card opens that chat.
+ * There is no "clear all" here.
+ */
+@Composable
+internal fun InboxCards(items: List<InboxItem>, s: IslandSettings, width: Dp) {
+    val locked by IslandBus.locked.collectAsState()
+    val now = rememberWallNow(30_000)
+    IslandTextTheme(s) {
+        Column(
+            Modifier.width(width).heightIn(max = s.expandedMaxHeight.dp).verticalScroll(rememberScrollState()),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            items.asReversed().forEach { item ->
+                androidx.compose.runtime.key(item.key) { InboxCard(item, s, locked, now) }
+            }
+        }
+    }
