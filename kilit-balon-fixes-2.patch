+/** iOS-style pill button of a notification card: gray for "Reply", blue-tinted for the second action. */
+@Composable
+private fun PillAction(title: String, tinted: Boolean, modifier: Modifier = Modifier, onClick: () -> Unit) {
+    val haptic = rememberHaptic()
+    val interaction = remember { MutableInteractionSource() }
+    val pressed by interaction.collectIsPressedAsState()
+    val bg = if (tinted) Tints.Blue.copy(alpha = 0.22f) else Color.White.copy(alpha = 0.16f)
+    val fg = if (tinted) Color(0xFF4DA3FF) else Color.White
+    Box(
+        modifier
+            .heightIn(min = 40.dp)
+            .clip(CircleShape)
+            .background(bg.copy(alpha = bg.alpha * if (pressed) 0.6f else 1f))
+            .clickable(interaction, indication = null) {
+                haptic()
+                onClick()
+            }
+            .padding(horizontal = 12.dp),
+        contentAlignment = Alignment.Center,
