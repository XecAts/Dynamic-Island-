+/** Width of the messages bubble in bubble heights: 1 for one notification, then 1.55 and 2.1 for two and three. */
+internal fun inboxClusterFactor(items: List<InboxItem>?): Float {
+    val n = items?.size ?: 1
+    return 1f + 0.55f * (n.coerceIn(1, 3) - 1)
