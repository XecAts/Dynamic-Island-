     /**
+     * Lock-screen control panel (stopwatch/timer card on top, player below). Its own window at the bottom of the
+     * screen, just above the phone / camera shortcuts, as wide as the cards and as tall as their content, so it
+     * takes touches (buttons, seek bar) only where the cards are. The cards come from [LockPanelState].
+     */
+    private fun createLockPanel() {
+        val compose = ComposeView(this).apply {
+            setViewCompositionStrategy(ViewCompositionStrategy.DisposeOnDetachedFromWindow)
+            setContent { IslandTheme { LangScope { LockPanel() } } }
+        }
+        val root = android.widget.FrameLayout(this)
+        root.addView(compose)
+        owner.attach(root)
+        val widthDp = (resources.configuration.screenWidthDp - 32).coerceIn(0, 460)
+        val params = WindowManager.LayoutParams(
+            dp(widthDp),
+            WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+                WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
+                WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL
+            // The shortcuts (phone, camera) end about 12% of the screen height above the bottom edge
+            y = (resources.displayMetrics.heightPixels * 0.12f).toInt()
+            title = "DynamicIslandLock"
+        }
+        root.visibility = View.GONE
+        runCatching { wm?.addView(root, params) }.onSuccess { lockPanel = root }
+        scope.launch {
+            LockPanelState.acts.collect { updateLockPanel() }
+        }
+    }
+
+    private fun updateLockPanel() {
+        val root = lockPanel ?: return
+        val show = visible && IslandBus.keyguard.value && LockPanelState.acts.value.isNotEmpty()
+        root.visibility = if (show) View.VISIBLE else View.GONE
+    }
